  "not_built_note": "Windows components this runtime does not build at all, with the reason. Unlike not_shipped, which is the iOS build dropping a module Wine has, these are names Wine has never had; a program importing one cannot be served, and the engine reports it as unavailable rather than as a file the title will ship.",
  "not_built": [
    {
      "name": "amdxc64",
      "reason": "AMD's DX11 shader compiler driver component; there is no AMD driver behind Metal"
    },
    {
      "name": "amdxcffx64",
      "reason": "AMD's FidelityFX driver component; there is no AMD driver behind Metal"
    },
    {
      "name": "amfrt64",
      "reason": "AMD's Media Framework runtime; there is no AMD driver behind Metal"
    },
    {
      "name": "atiadlxx",
      "reason": "AMD's display library; there is no AMD driver behind Metal"
    },
    {
      "name": "atiumd64",
      "reason": "AMD's user-mode display driver; there is no AMD driver behind Metal"
    },
    {
      "name": "atiumd6a",
      "reason": "AMD's video component; there is no AMD driver behind Metal"
    },
    {
      "name": "d3d11_1",
      "reason": "Windows 8 renamed the Direct3D 11.1 interfaces into a second DLL; Wine exports them from d3d11.dll, which is the file a title should link"
    },
    {
      "name": "d3dcompiler_44",
      "reason": "a DirectX SDK shader compiler; Wine builds d3dcompiler_33 through 43, 46 and 47"
    },
    {
      "name": "d3dcompiler_45",
      "reason": "a DirectX SDK shader compiler; Wine builds d3dcompiler_33 through 43, 46 and 47"
    },
    {
      "name": "dxcompiler",
      "reason": "the DirectX Shader Compiler, a redistributable that ships with the title rather than with Windows; neither Wine nor DXMT builds it"
    },
    {
      "name": "dxgi1_2",
      "reason": "Windows 8 split the DXGI 1.2 interfaces into this DLL; Wine exports them from dxgi.dll"
    },
    {
      "name": "dxgi1_3",
      "reason": "Windows 8.1 split the DXGI 1.3 interfaces into this DLL; Wine exports them from dxgi.dll"
    },
    {
      "name": "dxgi1_4",
      "reason": "Windows 10 split the DXGI 1.4 interfaces into this DLL; Wine exports them from dxgi.dll"
    },
    {
      "name": "dxil",
      "reason": "the DirectX Shader Compiler's validator, a redistributable that ships with the title rather than with Windows; neither Wine nor DXMT builds it"
    },
    {
      "name": "mfcore",
      "reason": "Windows 8 split the Media Foundation platform in two; Wine implements the platform API in mfplat.dll and has no mfcore module"
    },
    {
      "name": "mscoreei",
      "reason": ".NET's installation shim; Wine has one managed entry point, mscoree.dll"
    },
    {
      "name": "nvapi",
      "reason": "NVIDIA's driver interface; there is no NVIDIA driver behind Metal, and DXMT's nvapi module is not in the farms this app ships"
    },
    {
      "name": "nvapi64",
      "reason": "NVIDIA's driver interface; there is no NVIDIA driver behind Metal, and DXMT's nvapi64 module is not in the farms this app ships"
    },
    {
      "name": "nvngx",
      "reason": "the DLSS entry point behind NVAPI; DXMT builds one and this app does not ship it"
    },
    {
      "name": "nvngx_dlss",
      "reason": "the DLSS runtime a title ships itself; it needs an NVIDIA driver, which Metal is not"
    },
