+/* Madeira op 8: draw a back buffer into a drawable whose pixel format differs.
+ *
+ * A Metal blit copies bytes and needs both textures in one format; a CAMetalLayer
+ * displays only a few formats (madeira_layer_format.h). When a D3D12 swapchain's
+ * format is not one of them, its layer gets the closest one and the present draws
+ * one full-screen triangle sampling the back buffer instead: the GPU converts
+ * (RGBA8 -> BGRA8, sRGB encodings kept, any size scaled with a linear filter).
+ * The shader is Metal source compiled once per device and destination format at
+ * run time; nothing is shipped prebuilt. Local backend only (ret = 0 in remote
+ * mode, and when anything is missing: the caller drops that frame). */
+/* struct madeira_present_convert: winemetal.h */
+static const char madeira_convert_msl[] =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "struct madeira_cv { float4 pos [[position]]; float2 uv; };\n"
+    "vertex madeira_cv madeira_convert_vs(uint vid [[vertex_id]]) {\n"
+    "  float2 p = float2(float((vid << 1) & 2u), float(vid & 2u));\n"
+    "  madeira_cv o; o.pos = float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0); o.uv = p; return o;\n"
+    "}\n"
+    "fragment float4 madeira_convert_fs(madeira_cv in [[stage_in]], texture2d<float> src [[texture(0)]]) {\n"
+    "  constexpr sampler s(coord::normalized, filter::linear, address::clamp_to_edge);\n"
+    "  return src.sample(s, in.uv);\n"
+    "}\n";
+static pthread_mutex_t madeira_convert_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { id<MTLDevice> dev; MTLPixelFormat pf; id<MTLRenderPipelineState> pso; } madeira_convert_cache[4];
+static struct { id<MTLDevice> dev; MTLPixelFormat pf; } madeira_convert_failed[4];   /* not retried every frame */
+static id<MTLRenderPipelineState> madeira_convert_pipeline(id<MTLDevice> dev, MTLPixelFormat pf) {
+  static id<MTLDevice> lib_dev, lib_failed_dev;
+  static id<MTLLibrary> lib;
+  id<MTLRenderPipelineState> pso = nil;
+  unsigned i;
+  pthread_mutex_lock(&madeira_convert_lock);
+  for (i = 0; i < 4; i++)
+    if (madeira_convert_cache[i].pso && madeira_convert_cache[i].dev == dev && madeira_convert_cache[i].pf == pf) {
+      pso = madeira_convert_cache[i].pso;
+      break;
+    }
+  for (i = 0; !pso && i < 4; i++)
+    if (madeira_convert_failed[i].dev == dev && madeira_convert_failed[i].pf == pf && dev) {
+      pthread_mutex_unlock(&madeira_convert_lock);
+      return nil;
+    }
+  if (!pso && lib_failed_dev == dev) {
+    pthread_mutex_unlock(&madeira_convert_lock);
+    return nil;
+  }
+  if (!pso) {
+    NSError *err = nil;
+    if (!lib || lib_dev != dev) {
+      MTLCompileOptions *opt = [[MTLCompileOptions alloc] init];
+      if (lib) [lib release];
+      lib = [dev newLibraryWithSource:[NSString stringWithUTF8String:madeira_convert_msl] options:opt error:&err];
+      lib_dev = dev;
+      [opt release];
+      if (!lib) {
+        lib_failed_dev = dev;
+        fprintf(stderr, "[madeira-display] present conversion: the shader did not compile: %s\n",
+                err ? err.localizedDescription.UTF8String : "?");
+      }
+    }
+    if (lib) {
+      MTLRenderPipelineDescriptor *d = [[MTLRenderPipelineDescriptor alloc] init];
+      id<MTLFunction> vs = [lib newFunctionWithName:@"madeira_convert_vs"];
+      id<MTLFunction> fs = [lib newFunctionWithName:@"madeira_convert_fs"];
+      d.vertexFunction = vs;
+      d.fragmentFunction = fs;
+      d.colorAttachments[0].pixelFormat = pf;
+      err = nil;
+      pso = [dev newRenderPipelineStateWithDescriptor:d error:&err];
+      [vs release];
+      [fs release];
+      [d release];
+      if (!pso) {
+        for (i = 0; i < 3 && madeira_convert_failed[i].dev; i++) {}
+        madeira_convert_failed[i].dev = dev;
+        madeira_convert_failed[i].pf = pf;
+        fprintf(stderr, "[madeira-display] present conversion: newRenderPipelineState failed for format %u: %s\n",
+                (unsigned)pf, err ? err.localizedDescription.UTF8String : "?");
+      } else {
+        for (i = 0; i < 4 && madeira_convert_cache[i].pso; i++) {}
+        if (i == 4) { [madeira_convert_cache[3].pso release]; i = 3; }
+        madeira_convert_cache[i].dev = dev;
+        madeira_convert_cache[i].pf = pf;
+        madeira_convert_cache[i].pso = pso;   /* the cache owns the +1 */
+        fprintf(stderr, "[madeira-display] present conversion ready for drawable format %u\n", (unsigned)pf);
+      }
+    }
+  }
+  pthread_mutex_unlock(&madeira_convert_lock);
+  return pso;
+}
+static int madeira_present_convert_encode(const struct madeira_present_convert *c) {
+  id<MTLCommandBuffer> cb = (id<MTLCommandBuffer>)(uintptr_t)c->cmdbuf;
+  id<MTLTexture> src = (id<MTLTexture>)(uintptr_t)c->src, dst = (id<MTLTexture>)(uintptr_t)c->dst;
+  id<MTLRenderPipelineState> pso;
+  MTLRenderPassDescriptor *rp;
+  id<MTLRenderCommandEncoder> enc;
+  if (!cb || !src || !dst) return 0;
+  pso = madeira_convert_pipeline(cb.device, dst.pixelFormat);
+  if (!pso) return 0;
+  rp = [MTLRenderPassDescriptor renderPassDescriptor];
+  rp.colorAttachments[0].texture = dst;
+  rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+  rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+  enc = [cb renderCommandEncoderWithDescriptor:rp];
+  if (!enc) return 0;
+  if (c->fence) [enc waitForFence:(id<MTLFence>)(uintptr_t)c->fence beforeStages:MTLRenderStageFragment];
+  [enc setRenderPipelineState:pso];
+  [enc setFragmentTexture:src atIndex:0];
+  [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
