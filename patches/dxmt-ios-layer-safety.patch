diff --git a/src/winemetal/madeira_layer_format.h b/src/winemetal/madeira_layer_format.h
new file mode 100644
index 0000000..baa01a9
--- /dev/null
+++ b/src/winemetal/madeira_layer_format.h
@@ -0,0 +1,72 @@
+/* Madeira: the pixel formats a CAMetalLayer is documented to display.
+ *
+ * Apple documents BGRA8Unorm, BGRA8Unorm_sRGB, RGBA16Float, RGB10A2Unorm,
+ * BGR10A2Unorm and the four XR formats for -[CAMetalLayer setPixelFormat:];
+ * another format may raise CAMetalLayerInvalid ("invalid pixel format 70" for
+ * RGBA8Unorm on macOS), which ends the app. Device runs show the A15 taking
+ * RGBA8Unorm, so winemetal tries the requested format first and uses
+ * madeira_layer_format_for() only when the layer refuses it. Whoever presents
+ * then reads the drawable's real format and draws (which converts) instead of
+ * copying bytes when it differs from the back buffer's.
+ *
+ * Plain C on the raw MTLPixelFormat / WMTPixelFormat numbers (they are the
+ * same for these formats), so the unix side, the PE side and host tests can
+ * all include it. */
+#ifndef MADEIRA_LAYER_FORMAT_H
+#define MADEIRA_LAYER_FORMAT_H
+
+#include <stdint.h>
+
+#define MADEIRA_PF_B5G6R5_UNORM      40u
+#define MADEIRA_PF_A1BGR5_UNORM      41u
+#define MADEIRA_PF_ABGR4_UNORM       42u
+#define MADEIRA_PF_BGR5A1_UNORM      43u
+#define MADEIRA_PF_RGBA8_UNORM       70u
+#define MADEIRA_PF_RGBA8_UNORM_SRGB  71u
+#define MADEIRA_PF_BGRA8_UNORM       80u
+#define MADEIRA_PF_BGRA8_UNORM_SRGB  81u
+#define MADEIRA_PF_RGB10A2_UNORM     90u
+#define MADEIRA_PF_RG11B10_FLOAT     92u
+#define MADEIRA_PF_RGB9E5_FLOAT      93u
+#define MADEIRA_PF_BGR10A2_UNORM     94u
+#define MADEIRA_PF_RGBA16_UNORM     110u
+#define MADEIRA_PF_RGBA16_FLOAT     115u
+#define MADEIRA_PF_RGBA32_FLOAT     125u
+#define MADEIRA_PF_BGRA10_XR        552u
+#define MADEIRA_PF_BGRA10_XR_SRGB   553u
+#define MADEIRA_PF_BGR10_XR         554u
+#define MADEIRA_PF_BGR10_XR_SRGB    555u
+/* WMTPixelFormatCustomSwizzle (winemetal.h): view flags above the format number */
+#define MADEIRA_PF_SWIZZLE_FLAGS    0x00F00000u
+
+/* 1 when the layer can take this format as is. */
+static inline int madeira_layer_format_ok(uint32_t format) {
+  switch (format & ~MADEIRA_PF_SWIZZLE_FLAGS) {
+  case MADEIRA_PF_BGRA8_UNORM: case MADEIRA_PF_BGRA8_UNORM_SRGB:
+  case MADEIRA_PF_RGBA16_FLOAT: case MADEIRA_PF_RGB10A2_UNORM: case MADEIRA_PF_BGR10A2_UNORM:
+  case MADEIRA_PF_BGRA10_XR: case MADEIRA_PF_BGRA10_XR_SRGB:
+  case MADEIRA_PF_BGR10_XR: case MADEIRA_PF_BGR10_XR_SRGB:
+    return 1;
+  default:
+    return 0;
+  }
+}
+
+/* The format the layer gets for a back buffer of this format: the format
+ * itself when the layer takes it, else the closest one it takes (same sRGB
+ * encoding for 8-bit colour, half float for wider or float formats). */
+static inline uint32_t madeira_layer_format_for(uint32_t format) {
+  uint32_t f = format & ~MADEIRA_PF_SWIZZLE_FLAGS;
+  if (madeira_layer_format_ok(f)) return f;
+  switch (f) {
+  case MADEIRA_PF_RGBA8_UNORM_SRGB:
+    return MADEIRA_PF_BGRA8_UNORM_SRGB;
+  case MADEIRA_PF_RG11B10_FLOAT: case MADEIRA_PF_RGB9E5_FLOAT:
+  case MADEIRA_PF_RGBA16_UNORM: case MADEIRA_PF_RGBA32_FLOAT:
+    return MADEIRA_PF_RGBA16_FLOAT;
+  default:   /* RGBA8, the 16-bit formats, anything else */
+    return MADEIRA_PF_BGRA8_UNORM;
+  }
+}
+
+#endif
