index 2b7df0d..99ae2c1 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -152,11 +152,82 @@ typedef int NTSTATUS;
 
 void
 execute_on_main(dispatch_block_t block) {
+  /* Madeira: a bounded hop to the main thread.
+   *
+   * This used to be dispatch_sync(main). The callers are CAMetalLayer property
+   * updates (_MetalLayer_setProps, _MetalLayer_setColorSpace) that DXMT makes
+   * from the game's render thread while it creates a swapchain (the
+   * constructor's ResizeBuffers -> Presenter::changeLayerProperties) and on
+   * the first Present (Presenter::synchronizeLayerProperties, with the D3D11
+   * device mutex held). dispatch_sync has no timeout: whenever the iOS main
+   * thread does not drain its queue -- busy for seconds, or itself waiting on
+   * something a guest thread holds -- swapchain creation never returns, the
+   * game stays at "device created", and nothing is ever logged. That is the
+   * "process alive, NO FRAME PRESENTED" shape.
+   *
+   * Now the update is queued to the main thread and the caller waits at most
+   * MADEIRA_MAIN_HOP_TIMEOUT_MS (default 2000; 0 = wait forever, the old
+   * behaviour). Exactly one side runs the block: whichever claims it first.
+   * When the wait expires the caller claims it and applies the update on its
+   * own thread inside an explicit CATransaction (Core Animation layer
+   * properties may be set off the main thread; a thread without a run loop
+   * needs the explicit transaction), and the queued copy does nothing when the
+   * main thread gets to it. Because the caller never returns before the block
+   * ran, pointers the block reads (the presenter's layer props) are still
+   * valid when it runs. */
   if ([NSThread isMainThread]) {
     block();
-  } else {
+    return;
+  }
+  static long timeout_ms = -1;
+  if (timeout_ms < 0) {
+    const char *e = getenv("MADEIRA_MAIN_HOP_TIMEOUT_MS");
+    long v = (e && *e) ? atol(e) : 2000;
+    timeout_ms = v < 0 ? 2000 : v;
+  }
+  if (timeout_ms == 0) {
+    dispatch_sync(dispatch_get_main_queue(), block);
+    return;
+  }
+  /* 0 pending, 1 claimed by the main thread, 2 claimed by the caller.
+   * Two owners (this frame and the queued block); the last one frees it. */
+  struct hop { _Atomic int state; _Atomic int refs; } *hop = calloc(1, sizeof *hop);
+  if (!hop) {
     dispatch_sync(dispatch_get_main_queue(), block);
+    return;
+  }
+  atomic_store(&hop->refs, 2);
+  dispatch_semaphore_t done = dispatch_semaphore_create(0);
+  dispatch_async(dispatch_get_main_queue(), ^{
+    int expect = 0;
+    if (atomic_compare_exchange_strong(&hop->state, &expect, 1)) {
+      block();
+      dispatch_semaphore_signal(done);
+    }
+    if (atomic_fetch_sub(&hop->refs, 1) == 1)
+      free(hop);
+  });
+  if (dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, (int64_t)timeout_ms * NSEC_PER_MSEC)) != 0) {
+    int expect = 0;
+    if (atomic_compare_exchange_strong(&hop->state, &expect, 2)) {
+      static _Atomic unsigned long late;
+      unsigned long n = atomic_fetch_add(&late, 1) + 1;
+      if (n <= 8 || (n % 256) == 0)
+        fprintf(stderr, "[madeira-main-hop] winemetal: the main thread did not run a Metal layer update within "
+                        "%ld ms (%lu times); applied on this thread instead -- the main thread is busy or "
+                        "blocked\n", timeout_ms, n);
+      [CATransaction begin];
+      [CATransaction setDisableActions:YES];
+      block();
+      [CATransaction commit];
+    } else {
+      /* The main thread took it just now and is running it: wait for that. */
+      dispatch_semaphore_wait(done, DISPATCH_TIME_FOREVER);
+    }
   }
+  dispatch_release(done);
+  if (atomic_fetch_sub(&hop->refs, 1) == 1)
+    free(hop);
 }
 
